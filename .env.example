# Copy to .env and fill in. Never commit .env.
#   cp .env.example .env && chmod 600 .env

# ── Pinnarr ──────────────────────────────────────
PINNARR_BASE_URL=http://pinnarr.lan:8737
TZ=Europe/London
DATABASE_PATH=/data/pinnarr.db
LOG_LEVEL=INFO

# Shared secret for the Sonarr webhook. Generate with:
#   openssl rand -hex 24
WEBHOOK_SECRET=

# ── Plex ─────────────────────────────────────────
PLEX_URL=http://192.168.1.10:32400
PLEX_TOKEN=
# Comma-separated Plex library section IDs for TV. Leave blank to
# auto-detect every section of type "show" on first sync.
PLEX_TV_SECTIONS=

# ── Sonarr ───────────────────────────────────────
SONARR_URL=http://192.168.1.20:8989
SONARR_API_KEY=

# ── Tautulli ─────────────────────────────────────
TAUTULLI_URL=http://192.168.1.20:8181
TAUTULLI_API_KEY=

# ── TMDB (season outlook) ────────────────────────
# Free key: https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# ── Radarr (v1.5, not yet used) ──────────────────
RADARR_ENABLED=false
RADARR_URL=
RADARR_API_KEY=

# ── Notifications ────────────────────────────────
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=
NOTIFY_ON_ARRIVAL=true
DIGEST_ENABLED=true
DIGEST_CRON=0 8 * * 1

# ── Outlook thresholds (tunable, see SPEC §10) ───
HIATUS_MONTHS=9
DORMANT_MONTHS=18
