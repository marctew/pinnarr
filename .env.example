# ── Bootstrap only ───────────────────────────────
# Everything else — Plex, Sonarr, Tautulli, TMDB, ntfy, schedules — is
# configured in the admin panel at /settings and stored in the database.
# These two are here because they have to be: the app needs to find and open
# the database before it can read any settings out of it.

DATABASE_PATH=/data/pinnarr.db
LOG_LEVEL=INFO
